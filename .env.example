# Database
DATABASE_URL="postgresql://user:password@localhost:5432/erp_db"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_...
FROM_EMAIL=orders@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Sentry Error Tracking
SENTRY_DSN=https://xxx@o4xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o4xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_...

# File Uploads (local, s3, or r2)
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Database Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Payment Webhook Secrets (for signature verification)
# Stripe: found in Stripe Dashboard > Developers > Webhooks > your endpoint
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SECRET_KEY=sk_live_...

# Paystack: your secret key is used to compute the HMAC-SHA512 signature
# PAYSTACK_SECRET_KEY=sk_live_...

# Flutterwave: secret hash configured in Flutterwave dashboard webhook settings
# FLUTTERWAVE_SECRET_HASH=your_secret_hash_here

# M-Pesa: shared secret appended to callback URL for verification
# MPESA_WEBHOOK_SECRET=your_random_secret_string

# Redis (optional - for production rate limiting)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
